{
  "name": "aeon-ai",
  "version": "0.3.0",
  "type": "module",
  "description": "AEON — your personal coding companion. A terminal AI coding agent with a TUI, tool use, and guardrails.",
  "license": "MIT",
  "author": "Ashu463",
  "homepage": "https://github.com/Ashu463/pi-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashu463/pi-cli.git",
    "directory": "apps/pi-cli"
  },
  "bugs": {
    "url": "https://github.com/Ashu463/pi-cli/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "coding-agent",
    "llm",
    "deepseek",
    "openai",
    "anthropic"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build --target node src/index.ts --outfile dist/index.js --external '@opentui/*' --external react",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@repo/agent": "workspace:*",
    "@repo/tui": "workspace:*"
  },
  "main": "dist/index.js",
  "bin": {
    "aeon": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
